# Copy to a protected deployment location or to .env (which is gitignored).
# Never commit real credentials.
DISCORD_TOKEN=replace_with_discord_bot_token

# Mandatory Discord authorization allowlists (comma-separated numeric IDs).
DISCORD_GUILD_IDS=123456789012345678
DISCORD_CHANNEL_IDS=123456789012345678
DISCORD_ALLOWED_ROLE_IDS=123456789012345678
DISCORD_ADMIN_ROLE_IDS=123456789012345678
DISCORD_SYNC_COMMANDS=true

# Local-run paths. Compose overrides these with /repo, /data, and /app/config.
# Replace the placeholders before sourcing this file outside Docker.
PROJECT_ROOT=/absolute/path/to/basketball
BOT_DATA_DIR=/absolute/path/outside/repository/basketball-bot-data
SOURCES_CONFIG=/absolute/path/to/basketball/discord_project_assistant/config/project_sources.yaml

# Reuse the ChatGPT login cached under CODEX_HOME. Do not add an API key.
AI_PROVIDER=codex
CODEX_AUTH_MODE=chatgpt_login
CODEX_BINARY=codex
CODEX_HOME=/absolute/path/outside/repository/basketball-bot-data/codex-home
# gpt-6-luna is the quota-saving recommendation; leave empty to use the workspace default.
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=45
AI_MAX_ANSWER_CHARS=3500
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_CHARS=16000

# Cost and abuse controls.
DAILY_AI_REQUEST_LIMIT=40
PER_USER_DAILY_AI_REQUEST_LIMIT=5
PER_USER_MINUTE_COMMAND_LIMIT=12
DISCORD_MESSAGE_CHARS=1900
LOG_LEVEL=INFO
